# Aruba (Apache): pagina 404 e cache lunga per le risorse con hash nel nome
ErrorDocument 404 /404.html
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^.*\.(webp|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Vecchie categorie ancora senza opere: rimanda a /opere/ (302, temporaneo).
# Appena una categoria ha un'opera, la sua pagina esiste e la regola non scatta più.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^opere/(bronzi|incisioni|legni|rame|terracotta)/?$ /opere/ [R=302,L]
  # Vecchia URL della home WordPress
  RewriteRule ^home-4/?$ / [R=301,L]
</IfModule>
