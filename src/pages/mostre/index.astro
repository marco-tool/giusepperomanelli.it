---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

const intro = await getEntry('pagine', 'mostre');
const { Content } = await render(intro!);
const mostre = (await getCollection('mostre')).sort((a, b) => a.data.data.valueOf() - b.data.data.valueOf());
const conPagina = (m: (typeof mostre)[number]) => (m.body ?? '').trim().length > 0;
const testo = (t: string) => t.replace(/^\d{4},\s*/, '');
---
<Base title="Mostre">
  <div class="prose">
    <h1>Mostre</h1>
    <Content />
  </div>
  <h2 class="page-title" style="font-size:1.6rem;margin:56px 0 16px;max-width:820px">Mostre documentate</h2>
  <ul class="timeline">
    {mostre.map((m) => (
      <li>
        <span class="year">{m.data.data.getFullYear()}</span>
        <span class="what">
          {conPagina(m) ? <a href={`/mostre/${m.id}/`}>{testo(m.data.title)}</a> : testo(m.data.title)}
          {m.data.luogo && <small>{m.data.luogo}</small>}
        </span>
        <span class="thumb">{m.data.copertina && <a href={`/mostre/${m.id}/`} tabindex="-1"><Image src={m.data.copertina} alt="" width={220} /></a>}</span>
      </li>
    ))}
  </ul>
</Base>
