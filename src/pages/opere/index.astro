---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { CATEGORIE } from '../../categorie';

const opere = (await getCollection('opere')).sort((a, b) => (a.data.anno ?? 9999) - (b.data.anno ?? 9999));
const presenti = Object.entries(CATEGORIE).filter(([k]) => opere.some((o) => o.data.categoria === k));
---
<Base title="Opere">
  <h1 class="page-title">Opere</h1>
  <p class="lead">Una selezione delle sculture. Il catalogo è in corso di riordino: nuove opere verranno aggiunte nel tempo.</p>
  <nav class="cat-nav">
    {presenti.map(([k, label]) => <a href={`/opere/${k}/`}>{label}</a>)}
  </nav>
  <div class="grid">
    {opere.map((o) => (
      <a class="work" href={`/opera/${o.id}/`}>
        <div class="frame"><Image src={o.data.immagini[0]} alt={o.data.title} widths={[300, 600]} sizes="300px" /></div>
        <h3>{o.data.title}</h3>
        <p>{[o.data.anno, o.data.materiale].filter(Boolean).join(' · ')}</p>
      </a>
    ))}
  </div>
</Base>
