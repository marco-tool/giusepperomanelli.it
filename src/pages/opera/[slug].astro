---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Griglia from '../../components/Griglia.astro';
import { CATEGORIE, annoOrdine, type Categoria } from '../../categorie';
import { ogImage, autore, briciole, primaFrase, taglia, titoloSeo, SITE, SUFFISSO } from '../../seo';

const ARTFORM: Record<Categoria, string> = {
  alabastri: 'Scultura', bronzi: 'Scultura', legni: 'Scultura', terracotta: 'Scultura', rame: 'Sbalzo',
  incisioni: 'Incisione', disegni: 'Disegno', 'altri-materiali': 'Scultura',
};

export async function getStaticPaths() {
  const opere = await getCollection('opere');
  // titoli uguali (es. 7 "Disegno senza titolo, 1971"): numerati per renderli unici
  const gruppi = new Map<string, string[]>();
  for (const o of [...opere].sort((a, b) => a.id.localeCompare(b.id))) {
    const t = titoloSeo(o.data);
    gruppi.set(t, [...(gruppi.get(t) ?? []), o.id]);
  }
  const seo = new Map<string, string>();
  for (const [t, ids] of gruppi) ids.forEach((id, i) => seo.set(id, ids.length > 1 ? `${t} (${i + 1})` : t));
  return opere.map((o) => {
    const stesse = opere
      .filter((x) => x.data.categoria === o.data.categoria)
      .sort((a, b) => annoOrdine(a.data.anno) - annoOrdine(b.data.anno) || a.data.title.localeCompare(b.data.title, 'it'));
    const i = stesse.findIndex((x) => x.id === o.id);
    // "Altre opere": le 8 più vicine per data nella stessa categoria
    const vicine = stesse.filter((x) => x.id !== o.id)
      .sort((a, b) => Math.abs(stesse.indexOf(a) - i) - Math.abs(stesse.indexOf(b) - i)).slice(0, 8)
      .sort((a, b) => stesse.indexOf(a) - stesse.indexOf(b));
    return { params: { slug: o.id }, props: { o, prec: stesse[i - 1], succ: stesse[i + 1], vicine, totale: stesse.length, titolo: seo.get(o.id)! } };
  });
}
const { o, prec, succ, vicine, totale, titolo } = Astro.props;
const { Content } = await render(o);
const d = o.data;
const cat = CATEGORIE[d.categoria];
const path = `/opera/${o.id}/`;
const image = await ogImage(d.immagini[0]);

// Descrizione: titolo, tecnica, anno, autore, misure, numero di foto, prima frase della nota
const quando = typeof d.anno === 'number' ? ` del ${d.anno}` : d.anno ? `, ${d.anno}` : '';
const cosa = /senza titolo/i.test(d.title) ? titolo : `${d.title}${d.materiale ? `, ${d.materiale.toLowerCase()}` : ''}${quando}${titolo.match(/ \(\d+\)$/)?.[0] ?? ''}`;
const nota = primaFrase(o.body);
const descrizione = taglia([
  `${cosa} di Giuseppe Romanelli, ${SUFFISSO}.`,
  d.dimensioni ? `Misure: ${d.dimensioni}.` : '',
  d.immagini.length > 1 ? `${d.immagini.length} fotografie.` : '',
  nota,
].filter(Boolean).join(' '));

const opera = {
  '@type': 'VisualArtwork',
  name: d.title,
  url: `${SITE}${path}`,
  image,
  creator: autore,
  artform: ARTFORM[d.categoria],
  ...(d.materiale ? { artMedium: d.materiale } : {}),
  ...(typeof d.anno === 'number' ? { dateCreated: String(d.anno) } : {}),
  ...(d.dimensioni ? { size: d.dimensioni } : {}),
  description: descrizione,
};
const jsonld = [opera, briciole([['Giuseppe Romanelli', '/'], ['Opere', '/opere/'], [cat, `/opere/${d.categoria}/`], [d.title, path]])];
---
<Base title={titolo} description={descrizione} image={image} jsonld={jsonld}>
  <a class="back" href={`/opere/${d.categoria}/`}>← {cat} ({totale})</a>
  <div class="opera">
    <div class="images">
      {d.immagini.map((img, i) => (
        <figure>
          <Image src={img} alt={`${d.title}${d.immagini.length > 1 ? ` (foto ${i + 1} di ${d.immagini.length})` : ''}`} widths={[700, 1200, 1800]} sizes="(max-width: 800px) 100vw, 700px" loading={i ? 'lazy' : 'eager'} />
          {d.didascalie?.[i] && <figcaption>{d.didascalie[i]}</figcaption>}
        </figure>
      ))}
    </div>
    <div class="scheda">
      <h1 class="page-title">{d.title}</h1>
      <dl>
        {d.anno && <><dt>Anno</dt><dd>{d.anno}</dd></>}
        {d.materiale && <><dt>Tecnica</dt><dd>{d.materiale}</dd></>}
        {d.dimensioni && <><dt>Dimensioni</dt><dd>{d.dimensioni}</dd></>}
        <dt>Categoria</dt><dd><a href={`/opere/${d.categoria}/`}>{cat}</a></dd>
        {d.immagini.length > 1 && <><dt>Foto</dt><dd>{d.immagini.length}</dd></>}
      </dl>
      <div class="prose"><Content /></div>
      <nav class="pn">
        {prec ? <a href={`/opera/${prec.id}/`}>← {prec.data.title}</a> : <span />}
        {succ && <a href={`/opera/${succ.id}/`}>{succ.data.title} →</a>}
      </nav>
    </div>
  </div>
  {vicine.length > 0 && (
    <section class="altre">
      <h2>Altre opere · {cat}</h2>
      <Griglia opere={vicine} />
    </section>
  )}
</Base>
