---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const pagine = await getCollection('pagine', (p) => !['home', 'mostre'].includes(p.id));
  return pagine.map((p) => ({ params: { pagina: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
---
<Base title={p.data.title}>
  <article class={`prose${p.id === "opere-pubbliche" ? " captions" : ""}`}>
    <h1>{p.data.title}</h1>
    <Content />
  </article>
</Base>
